# Managed by Ansible on deploy; the primary/replica tag on each server line
# is then kept in sync afterward by pgcat-sync.sh (SIGHUP-reloaded), because
# PgCat has no built-in awareness of Patroni failover - see docs/pgcat.md.

[general]
host = "0.0.0.0"
port = {{ pgcat_backend_port }}
enable_prometheus_exporter = true
prometheus_exporter_port = {{ pgcat_prometheus_port }}
connect_timeout = 5000
healthcheck_timeout = 1000
healthcheck_delay = 30000
shutdown_timeout = 60000
ban_time = 60
log_client_connections = false
log_client_disconnections = false
admin_username = "{{ pgcat_admin_username }}"
admin_password = "{{ vault_pgcat_admin_password }}"

{% set pool_dbs = postgres_databases if postgres_databases | length > 0 else [{'name': 'postgres', 'owner': 'postgres'}] %}
{% for db in pool_dbs %}
[pools.{{ db.name }}]
pool_mode = "{{ pgcat_pool_mode }}"
default_role = "{{ pgcat_default_role }}"
query_parser_enabled = {{ pgcat_query_parser_enabled | lower }}
query_parser_read_write_splitting = {{ pgcat_query_parser_read_write_splitting | lower }}
primary_reads_enabled = {{ pgcat_primary_reads_enabled | lower }}

{% set pool_users = postgres_users if postgres_users | length > 0 else [] %}
[pools.{{ db.name }}.users.0]
# The postgres superuser is always available as a fallback/admin path.
username = "postgres"
password = "{{ vault_postgres_superuser_password }}"
pool_size = {{ pgcat_pool_size }}
statement_timeout = 0

{% for user in pool_users %}
[pools.{{ db.name }}.users.{{ loop.index }}]
username = "{{ user.name }}"
password = "{{ lookup('vars', user.password_var) }}"
pool_size = {{ pgcat_pool_size }}
statement_timeout = 0
{% endfor %}

[pools.{{ db.name }}.shards.0]
database = "{{ db.name }}"
servers = [
{% for host in groups['all'] %}
  [ "{{ hostvars[host]['ansible_host'] }}", {{ postgresql_port }}, "{{ 'primary' if host == (patroni_leader | default(groups['all'][0])) else 'replica' }}" ]{{ "," if not loop.last }}
{% endfor %}
]

{% endfor %}
