# Patroni configuration - managed by Ansible, do not edit by hand.
scope: {{ patroni_scope }}
name: {{ inventory_hostname }}
namespace: {{ patroni_namespace }}

restapi:
  listen: {{ ansible_default_ipv4.address }}:{{ patroni_api_port }}
  connect_address: {{ ansible_default_ipv4.address }}:{{ patroni_api_port }}
{% if patroni_restapi_auth_enabled %}
  # Protects the unsafe endpoints (switchover/failover/restart/reinitialize).
  # GET endpoints stay unauthenticated so HAProxy health checks keep working.
  authentication:
    username: {{ patroni_restapi_username }}
    password: "{{ vault_patroni_restapi_password }}"
{% endif %}
{% if patroni_restapi_tls_enabled %}
  certfile: {{ patroni_restapi_certfile }}
  keyfile: {{ patroni_restapi_keyfile }}
  cafile: {{ patroni_restapi_cafile }}
  verify_client: optional
{% endif %}

ctl:
{% if patroni_restapi_tls_enabled %}
  insecure: false
  cacert: {{ patroni_restapi_cafile }}
{% else %}
  insecure: true
{% endif %}

etcd3:
  hosts: {{ (groups['all'] | map('extract', hostvars, 'ansible_host') | product([':' + (etcd_client_port | string)]) | map('join')) | join(',') }}
{% if etcd_tls_enabled %}
  protocol: https
  cacert: {{ etcd_ca_file }}
  cert: {{ etcd_cert_file }}
  key: {{ etcd_key_file }}
{% else %}
  protocol: http
{% endif %}
{% if etcd_auth_enabled %}
  username: {{ etcd_username }}
  password: "{{ vault_etcd_password }}"
{% endif %}

{% if patroni_watchdog_enabled %}
watchdog:
  # Fencing: resets the host if Patroni stops feeding the watchdog, so a
  # hung Patroni can't leave PostgreSQL accepting writes past its lease.
  mode: {{ patroni_watchdog_mode }}
  device: {{ patroni_watchdog_device }}
  safety_margin: {{ patroni_watchdog_safety_margin }}
{% else %}
watchdog:
  mode: off
{% endif %}

bootstrap:
  method: initdb
  initdb:
    - encoding: UTF8
    - locale: C.UTF-8
    - data-checksums
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}
    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover }}
    primary_start_timeout: {{ patroni_primary_start_timeout }}
    primary_stop_timeout: {{ patroni_primary_stop_timeout }}
    synchronous_mode: {{ patroni_synchronous_mode }}
    synchronous_mode_strict: {{ patroni_synchronous_mode_strict | lower }}
    synchronous_node_count: {{ patroni_synchronous_node_count }}
    failsafe_mode: {{ patroni_failsafe_mode | lower }}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        # --- connections ---
        max_connections: {{ pg_max_connections }}
        superuser_reserved_connections: 5
        password_encryption: scram-sha-256
        max_locks_per_transaction: 512
        max_prepared_transactions: 0

        # --- memory ---
        huge_pages: try
        shared_buffers: {{ shared_buffers }}
        effective_cache_size: {{ effective_cache_size }}
        work_mem: {{ work_mem }}
        maintenance_work_mem: 1GB

        # --- checkpoints / WAL ---
        checkpoint_timeout: 15min
        checkpoint_completion_target: 0.9
        min_wal_size: 1GB
        max_wal_size: 4GB
        wal_buffers: 32MB
        wal_level: replica
        wal_log_hints: on
        wal_compression: on
        wal_keep_size: 2GB
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: on
        hot_standby_feedback: on
        max_standby_streaming_delay: 30s
        wal_receiver_status_interval: 10s
        synchronous_commit: on

        # --- archiving ---
        archive_mode: on
        archive_timeout: 1800s
{% if pgbackrest_enabled %}
        archive_command: "pgbackrest --stanza={{ pgbackrest_stanza }} archive-push %p"
        restore_command: "pgbackrest --stanza={{ pgbackrest_stanza }} archive-get %f \"%p\""
{% else %}
        # WARNING: no real WAL archiving configured. There is no PITR and no
        # backup - streaming replicas are not a backup. Set
        # pgbackrest_enabled: true, or wire up your own archive_command.
        archive_command: "/bin/true"
{% endif %}

        # --- planner ---
        default_statistics_target: 1000
        seq_page_cost: 1
        random_page_cost: 1.1
        effective_io_concurrency: 200
        jit: off

        # --- parallelism ---
        max_worker_processes: {{ [ansible_processor_vcpus | default(8) | int * 2, 8] | max }}
        max_parallel_workers: {{ [ansible_processor_vcpus | default(8) | int * 2, 8] | max }}
        max_parallel_workers_per_gather: 4
        max_parallel_maintenance_workers: 4

        # --- autovacuum ---
        autovacuum: on
        autovacuum_max_workers: 5
        autovacuum_vacuum_scale_factor: 0.01
        autovacuum_analyze_scale_factor: 0.01
        autovacuum_vacuum_cost_limit: 500
        autovacuum_vacuum_cost_delay: 2
        autovacuum_naptime: 1s

        # --- observability ---
        shared_preload_libraries: pg_stat_statements,auto_explain
        pg_stat_statements.max: 10000
        pg_stat_statements.track: all
        pg_stat_statements.track_utility: false
        pg_stat_statements.save: true
        auto_explain.log_min_duration: 10s
        auto_explain.log_analyze: true
        auto_explain.log_buffers: true
        auto_explain.log_timing: false
        auto_explain.log_triggers: true
        auto_explain.log_verbose: true
        auto_explain.log_nested_statements: true
        auto_explain.sample_rate: 0.01
        track_io_timing: on
        track_activities: on
        track_activity_query_size: 4096
        track_counts: on
        track_functions: all
        track_wal_io_timing: on

        # --- logging ---
        logging_collector: on
        log_directory: {{ '/var/log/postgresql' if __pg_uses_etc_config else 'log' }}
        log_filename: postgresql-%a.log
        log_truncate_on_rotation: on
        log_rotation_age: 1d
        log_rotation_size: 0
        log_line_prefix: '%m [%p-%l] %r %q%u@%d '
        log_checkpoints: on
        log_lock_waits: on
        log_temp_files: 0
        log_autovacuum_min_duration: 0
        log_min_duration_statement: 1000
        log_connections: on
        log_disconnections: on
        log_replication_commands: on
        log_timezone: '{{ pg_timezone }}'
        timezone: '{{ pg_timezone }}'

        # --- misc ---
        max_files_per_process: 4096
        idle_in_transaction_session_timeout: 10min
        tcp_keepalives_count: 10
        tcp_keepalives_idle: 300
        tcp_keepalives_interval: 30
{% if pg_ssl_enabled %}
        ssl: on
        # Resolved by tasks/pg_ssl.yml: either the operator-supplied
        # certificate or the self-signed pair this role generates. Patroni's
        # initdb does not create one, so leaving these unset means
        # PostgreSQL refuses to start with "could not load server
        # certificate file".
        ssl_cert_file: '{{ pg_ssl_effective_cert }}'
        ssl_key_file: '{{ pg_ssl_effective_key }}'
{% if pg_ssl_effective_ca | default('') | length > 0 %}
        ssl_ca_file: '{{ pg_ssl_effective_ca }}'
{% endif %}
        ssl_min_protocol_version: 'TLSv1.2'
{% endif %}

    pg_hba:
      # Local socket access. "peer" ties the DB user to the OS user, which
      # is what lets Patroni and our Ansible tasks connect without a password
      # while still refusing anyone who isn't already that OS user.
      - local all postgres peer
      - local all all scram-sha-256
      - local replication postgres peer
      - host all all 127.0.0.1/32 scram-sha-256
      - host all all ::1/128 scram-sha-256
{% for host in groups['all'] %}
      - {{ 'hostssl' if pg_require_ssl else 'host' }} replication replicator {{ hostvars[host]['ansible_host'] }}/32 scram-sha-256
{% endfor %}
{% for host in groups['all'] %}
      - {{ 'hostssl' if pg_require_ssl else 'host' }} all all {{ hostvars[host]['ansible_host'] }}/32 scram-sha-256
{% endfor %}
{% for network in pg_hba_extra_networks %}
      - {{ 'hostssl' if pg_require_ssl else 'host' }} all all {{ network }} scram-sha-256
{% endfor %}

postgresql:
{% if use_pgcat %}
  callbacks:
    # Triggers an immediate PgCat topology refresh on the node whose role
    # just changed, instead of waiting up to pgcat_sync_interval_seconds
    # for the periodic timer to notice.
    on_role_change: /usr/local/bin/pgcat-sync-topology.py
{% endif %}
  listen: {{ ansible_default_ipv4.address }},127.0.0.1:{{ postgresql_port }}
  connect_address: {{ ansible_default_ipv4.address }}:{{ postgresql_port }}
  use_unix_socket: true
  use_unix_socket_repl: true
  data_dir: {{ pg_data_dir }}
  bin_dir: {{ pg_bin_dir }}
{% if __pg_uses_etc_config %}
  config_dir: {{ pg_config_dir }}
{% endif %}
  pgpass: {{ '/var/lib/postgresql' if __pg_uses_etc_config else '/var/lib/pgsql' }}/.pgpass_patroni
  authentication:
    replication:
      username: replicator
      password: "{{ vault_postgres_replicator_password }}"
    superuser:
      username: postgres
      password: "{{ vault_postgres_superuser_password }}"
    rewind:
      username: rewind_user
      password: "{{ vault_postgres_superuser_password }}"
  parameters:
    unix_socket_directories: /var/run/postgresql
{% if pg_ssl_enabled %}
    # Repeated here (not only under bootstrap.dcs) because bootstrap.dcs is
    # read once, at bootstrap. A cluster that was already initialised - for
    # example one that failed to start because of a missing certificate -
    # picks the paths up from this local section on the next restart.
    ssl: 'on'
    ssl_cert_file: '{{ pg_ssl_effective_cert }}'
    ssl_key_file: '{{ pg_ssl_effective_key }}'
{% if pg_ssl_effective_ca | default('') | length > 0 %}
    ssl_ca_file: '{{ pg_ssl_effective_ca }}'
{% endif %}
{% endif %}

  # Never let Patroni silently wipe a data directory. If a rewind fails or
  # timelines diverge, stop and let a human look at it - the alternative is
  # destroying the only copy of data that hasn't been replicated yet.
  remove_data_directory_on_rewind_failure: false
  remove_data_directory_on_diverged_timelines: false

{% if pgbackrest_enabled %}
  create_replica_methods:
    # Prefer rebuilding a replica from the backup repo: it doesn't load the
    # primary, unlike pg_basebackup. Falls back to basebackup if the repo
    # isn't usable yet (e.g. before the first full backup exists).
    - pgbackrest
    - basebackup
  pgbackrest:
    command: "pgbackrest --stanza={{ pgbackrest_stanza }} --delta restore"
    keep_data: true
    no_params: true
    no_leader: true
{% else %}
  create_replica_methods:
    - basebackup
{% endif %}
  basebackup:
    max-rate: '100M'
    checkpoint: 'fast'

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
