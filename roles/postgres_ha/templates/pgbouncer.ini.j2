[databases]
postgres = host=/var/run/postgresql port={{ postgresql_port }} dbname=postgres
* = host=/var/run/postgresql port={{ postgresql_port }}

[pgbouncer]
logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /run/pgbouncer/pgbouncer.pid
listen_addr = 0.0.0.0
listen_port = {{ pgbouncer_port }}
unix_socket_dir = /var/run/pgbouncer
auth_type = scram-sha-256
auth_user = pgbouncer
auth_dbname = postgres
auth_query = SELECT usename, passwd FROM public.user_search($1)
# The auth_user needs its own credentials to run auth_query. Without this
# file PgBouncer can only reach PostgreSQL where pg_hba says "trust", which
# is exactly what we do not want (and is not what Patroni writes) - every
# client login then fails with "password authentication failed for user
# pgbouncer".
auth_file = {{ pgbouncer_conf_dir }}/userlist.txt
admin_users = postgres
stats_users = postgres
ignore_startup_parameters = extra_float_digits,geqo,search_path

pool_mode = transaction
server_reset_query = DISCARD ALL
max_client_conn = 80000
default_pool_size = 700
query_wait_timeout = 60
reserve_pool_size = 1
reserve_pool_timeout = 1
max_db_connections = 5000
pkt_buf = 8192
listen_backlog = 4096
max_prepared_statements = 1024
so_reuseport = 1

log_connections = 0
log_disconnections = 0
