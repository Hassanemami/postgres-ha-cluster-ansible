# Managed by Ansible - do not edit by hand.
#
# This file is only rendered in connection_mode: haproxy. In pgcat mode
# PgCat itself is the endpoint (see docs/PGCAT.md) and HAProxy is not
# installed at all - fronting PgCat with an HAProxy listener bound to the
# same port on the same host could never work.
global
    maxconn 100000
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    # /run/haproxy is created by the systemd drop-in this role installs
    # (RuntimeDirectory=haproxy); the distro packages do not create it.
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    # No "daemon" here on purpose: both distro units start HAProxy with -Ws
    # (master-worker + sd_notify, Type=notify) and forking would break that.
    # Modern TLS defaults for the stats listener.
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    mode               tcp
    log                global
    retries            2
    timeout queue      5s
    timeout connect    5s
    timeout client     60m
    timeout server     60m
    timeout check      15s

listen stats
    mode http
    bind 0.0.0.0:{{ haproxy_stats_port }}
    stats enable
    stats uri /
    stats refresh 10s
    # The stats page leaks cluster topology; require a login.
    stats auth {{ patroni_restapi_username }}:{{ vault_patroni_restapi_password }}
    stats hide-version

{# Route to PgBouncer when it is in play, otherwise straight to PostgreSQL. #}
{% set backend_port = pgbouncer_port if use_pgbouncer | default(true) else postgresql_port %}
listen master
    bind 0.0.0.0:{{ haproxy_primary_port }}
    maxconn 10000
    option tcplog
    option httpchk OPTIONS /primary
    http-check expect status 200
    default-server inter 3s fastinter 1s fall 3 rise 4 on-marked-down shutdown-sessions
    {% for host in groups['all'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ backend_port }} check port {{ patroni_api_port }}
    {% endfor %}

listen replicas
    bind 0.0.0.0:{{ haproxy_replicas_port }}
    maxconn 10000
    option tcplog
    option httpchk OPTIONS /replica
    balance roundrobin
    http-check expect status 200
    default-server inter 3s fastinter 1s fall 3 rise 2 on-marked-down shutdown-sessions
    {% for host in groups['all'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ backend_port }} check port {{ patroni_api_port }}
    {% endfor %}

listen replicas_sync
    bind 0.0.0.0:{{ haproxy_replicas_sync_port }}
    maxconn 10000
    option tcplog
    option httpchk OPTIONS /sync
    balance roundrobin
    http-check expect status 200
    default-server inter 3s fastinter 1s fall 3 rise 2 on-marked-down shutdown-sessions
    {% for host in groups['all'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ backend_port }} check port {{ patroni_api_port }}
    {% endfor %}

listen replicas_async
    bind 0.0.0.0:{{ haproxy_replicas_async_port }}
    maxconn 10000
    option tcplog
    option httpchk OPTIONS /async
    balance roundrobin
    http-check expect status 200
    default-server inter 3s fastinter 1s fall 3 rise 2 on-marked-down shutdown-sessions
    {% for host in groups['all'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ backend_port }} check port {{ patroni_api_port }}
    {% endfor %}
